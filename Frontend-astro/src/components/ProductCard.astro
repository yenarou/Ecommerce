---
import './ProductCard.css'
import { localePrefix, localizeProduct, t } from '../i18n'

const { product, locale = 'es' } = Astro.props
const root = localePrefix(locale)
const displayProduct = localizeProduct(product, locale)
---
<a href={`${root}/products/${product.id}`} class="product-card" aria-label={t(locale, 'productCard.view', { name: displayProduct.name })}>
  <div class="product-card__image">
    <img
      src={product.images[0]?.url}
      alt={displayProduct.name}
      width="800"
      height="600"
      loading="lazy"
      decoding="async"
    />
    {product.stock <= 3 && product.stock > 0 && <span class="product-card__tag">{t(locale, 'productCard.lastPieces')}</span>}
    {product.stock == 0 && <span class="product-card__tag">{t(locale, 'productCard.unavailable')}</span>}
  </div>
  <div class="product-card__body">
    <h3 class="product-card__name">{displayProduct.name}</h3>
    <p class="price">${product.price.toFixed(2)} {product.currency}</p>
  </div>
</a>