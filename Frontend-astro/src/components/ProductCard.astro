---
import './ProductCard.css'
import { useTranslations, rutaLocal } from '../i18n/ui.js'

const locale = Astro.currentLocale ?? 'es'
const t = useTranslations(locale)
const { product, level = 3, priority = false } = Astro.props
---
<a href={rutaLocal(locale, `/products/${product.id}`)} class="product-card">
  <div class="product-card__image">
    <img
      src={product.images[0]?.url}
      alt={product.images[0]?.alt || product.name}
      width="800"
      height="600"
      decoding="async"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
    />
    {product.stock <= 3 && product.stock > 0 && <span class="product-card__tag">{t('card.ultimas')}</span>}
    {product.stock == 0 && <span class="product-card__tag">{t('card.agotado')}</span>}
  </div>
  <div class="product-card__body">
    {level === 2
      ? <h2 class="product-card__name">{product.name}</h2>
      : <h3 class="product-card__name">{product.name}</h3>}
    <p class="price">${product.price.toFixed(2)} {product.currency}</p>
  </div>
</a>