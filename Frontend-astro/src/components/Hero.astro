---
import './Hero.css'
import { t } from '../i18n'
const locale = Astro.props.locale ?? 'es'
---
<section class="hero">
  <div class="hero__text">
    <p class="hero__eyebrow">{t(locale, 'hero.eyebrow')}</p>
    <h1 class="hero__title">
      {t(locale, 'hero.titleFirst')}
      <br />
      {t(locale, 'hero.titleSecond')}
    </h1>
    <p class="hero__subtitle">
      {t(locale, 'hero.subtitle')}
    </p>
  </div>
  <div class="hero__image" aria-hidden="true">
    <img src="/images/heroImg2.png" alt="" width="1200" height="1200" loading="eager" />
  </div>
</section>