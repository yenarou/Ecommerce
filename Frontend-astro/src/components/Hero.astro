---
import './Hero.css'
---
<section class="hero">
  <div class="hero__text">
    <p class="hero__eyebrow">Taller de crochet · Guadalajara</p>
    <h1 class="hero__title">
      Pequeñas piezas,
      <br />
      hechas para quedarse.
    </h1>
    <p class="hero__subtitle">
      Figuras, llaveros y decoración tejidos a mano, con tiempo y atención
      al detalle. Elige una pieza o hazla tuya.
    </p>
  </div>
  <div class="hero__image" aria-hidden="true">
    <img src="/images/heroImg2.png" alt="" />
  </div>
</section>