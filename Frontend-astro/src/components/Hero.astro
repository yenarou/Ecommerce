---
import './Hero.css'
import { useTranslations } from '../i18n/ui.js'

const t = useTranslations(Astro.currentLocale ?? 'es')
---
<section class="hero">
  <div class="hero__text">
    <p class="hero__eyebrow">{t('hero.eyebrow')}</p>
    <h1 class="hero__title">
      {t('hero.titulo1')}
      <br />
      {t('hero.titulo2')}
    </h1>
    <p class="hero__subtitle">{t('hero.subtitulo')}</p>
  </div>
  <div class="hero__image" aria-hidden="true">
    <img src="/images/heroImg2.webp" alt="" width="640" height="640" decoding="async" fetchpriority="high" />
  </div>
</section>