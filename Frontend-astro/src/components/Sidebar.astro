---
import { fetchCategories } from '../api/catalog'
import { useTranslations, rutaLocal, traducirCategoria } from '../i18n/ui.js'
import './Sidebar.css'

const locale = Astro.currentLocale ?? 'es'
const t = useTranslations(locale)
const categories: any[] = (await fetchCategories()).map((c: any) => traducirCategoria(locale, c))
---
<aside class="sidebar" aria-label={t('sidebar.aria')}>
  <div class="sidebar__block">
    <h2 class="sidebar__title">{t('sidebar.titulo')}</h2>
    <ul class="sidebar__list">
      {categories.map((cat) => (
        <li>
          <a href={rutaLocal(locale, `/categoria/${cat.slug}`)} class="sidebar__link">{cat.name}</a>
        </li>
      ))}
    </ul>
  </div>
</aside>