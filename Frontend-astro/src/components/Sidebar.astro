---
import { fetchCategories } from '../api/catalog'
import './Sidebar.css'
import { localePrefix, localizeCategory, t } from '../i18n'

const categories: any[] = await fetchCategories()
const locale = Astro.props.locale ?? 'es'
const root = localePrefix(locale)
---
<aside class="sidebar" aria-label={t(locale, 'sidebar.label')}>
  <div class="sidebar__block">
    <h2 class="sidebar__title">{t(locale, 'sidebar.collections')}</h2>
    <ul class="sidebar__list">
      {categories.map((category) => {
        const displayCategory = localizeCategory(category, locale)
        return (
          <li>
            <a href={`${root}/categoria/${category.slug}`} class="sidebar__link">{displayCategory.name}</a>
          </li>
        )
      })}
    </ul>
  </div>
</aside>