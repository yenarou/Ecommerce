---
import './Footer.css'
import { t } from '../i18n'
const locale = Astro.props.locale ?? 'es'
---
<footer class="footer">
  <div class="container footer__inner">
    <div>
      <h2 class="footer__brand">Hilo &amp; Alma</h2>
      <p class="footer__text">{t(locale, 'footer.location')}</p>
    </div>
    <div class="footer__cols">
      <div>
        <h3 class="footer__col-title">{t(locale, 'footer.contacts')}</h3>
        <p class="footer__text">andy@ceti.mx</p>
        <p class="footer__text">diego@ceti.mx</p>
        <p class="footer__text">genaro@ceti.mx</p>
      </div>
      <div>
        <h3 class="footer__col-title">{t(locale, 'footer.shipping')}</h3>
        <p class="footer__text">{t(locale, 'footer.localShipping')}</p>
        <p class="footer__text">{t(locale, 'footer.madeToOrder')}</p>
      </div>
    </div>
  </div>
  <p class="footer__legal">© {new Date().getFullYear()} Hilo y Alma</p>
</footer>