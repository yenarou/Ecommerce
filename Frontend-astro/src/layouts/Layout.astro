---
import '../styles/tokens.css'
import '../styles/responsive.css'
import TopBar from '../components/TopBar.astro'
import Footer from '../components/Footer.astro'
import CartBootstrap from '../components/CartBootstrap.jsx'
import { idiomas, useTranslations, quitarPrefijo, rutaLocal } from '../i18n/ui.js'

const locale = Astro.currentLocale ?? 'es'
const t = useTranslations(locale)

const {
  title = t('meta.titulo'),
  description = t('meta.descripcion'),
  image = '/images/heroImg2.png',
  jsonLd = null,
} = Astro.props

const sitio = Astro.site ?? Astro.url.origin
const canonical = new URL(Astro.url.pathname, sitio).href
const ogImage = new URL(image, canonical).href
const rutaBase = quitarPrefijo(Astro.url.pathname)
const alternas = Object.keys(idiomas).map((codigo) => ({
  codigo,
  href: new URL(rutaLocal(codigo, rutaBase), sitio).href,
}))
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternas.map((a) => <link rel="alternate" hreflang={a.codigo} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternas[0].href} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'es_MX'} />
    <meta property="og:site_name" content="Hilo y Alma" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#8b3a3a" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <CartBootstrap client:only="react" />
    <TopBar />
    <slot />
    <Footer />
    <script is:inline src="/registerSW.js"></script>
    <script is:inline>
  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    window.__pwaPrompt = e;
    window.dispatchEvent(new Event('pwa-installable'));
  });
  window.addEventListener('appinstalled', () => {
    window.__pwaPrompt = null;
    window.dispatchEvent(new Event('pwa-installed'));
  });
</script>
  </body>
</html>