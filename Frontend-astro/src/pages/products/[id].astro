---
import Layout from '../../layouts/Layout.astro'
import AddToCartForm from '../../components/AddToCartForm.jsx'
import { fetchProductById } from '../../api/catalog'
import { localizeCategory, t } from '../../i18n'
import '../../styles/ProductDetail.css'

const locale = 'es'
const { id } = Astro.params
const product = id ? await fetchProductById(id) : null
if (!product) Astro.response.status = 404
const category = product?.category
const displayCategory = localizeCategory(category, locale)
const productDescription = product
  ? `${product.name}: ${product.description || t(locale, 'product.defaultDescription')}`
  : t(locale, 'product.notFound')
const productJsonLd = product ? {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.description,
  sku: product.id,
  image: product.images?.map(img => img.url) || [],
  brand: { '@type': 'Brand', name: 'Hilo y Alma' },
  offers: {
    '@type': 'Offer',
    price: product.price,
    priceCurrency: product.currency,
    availability: product.stock > 0 ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
    url: `https://www.hilo-yalma.com/products/${product.id}`,
  },
} : null
---
<Layout
  title={product ? t(locale, 'site.titleWithName', { name: product.name }) : t(locale, 'product.notFoundTitle')}
  description={productDescription}
  canonical={product ? `https://www.hilo-yalma.com/products/${product.id}` : 'https://www.hilo-yalma.com'}
  type="product"
>
  {product ? (
  <div class="container product-detail">
    <nav class="product-detail__crumbs" aria-label="Ruta de navegación">
      <a href="/">{t(locale, 'category.home')}</a> <span aria-hidden="true">/</span>{' '}
      {displayCategory && <a href={`/categoria/${category.slug}`}>{displayCategory.name}</a>}{' '}
      <span aria-hidden="true">/</span> {product.name}
    </nav>

    <div class="product-detail__layout">
      <div class="product-detail__gallery">
        <div class="product-detail__main-image">
          <img
            src={product.images[0]?.url}
            alt={product.images[0]?.alt || product.name}
            width="1200"
            height="1200"
            loading="eager"
            decoding="async"
          />
        </div>
        {product.images.length > 1 && (
          <div class="product-detail__thumbs">
            {product.images.slice(1).map(img => (
              <div class="product-detail__thumb">
                <img src={img.url} alt={img.alt} width="800" height="800" loading="lazy" decoding="async" />
              </div>
            ))}
          </div>
        )}
      </div>

      <div class="product-detail__info">
        <h1 class="product-detail__name">{product.name}</h1>
        <p class="price product-detail__price">${product.price.toFixed(2)} {product.currency}</p>
        <p class="product-detail__description">{product.description}</p>

        <dl class="product-detail__facts">
          <div>
            <dt>{t(locale, 'product.availability')}</dt>
            <dd
              id="product-stock"
              data-product-id={product.id}
              data-stock={product.stock}
              aria-live="polite"
            >{product.stock > 0 ? t(locale, 'product.pieces', { count: product.stock }) : t(locale, 'product.soldOut')}</dd>
          </div>
        </dl>

        <hr class="stitch-divider" />

        <AddToCartForm client:load product={product} locale={locale} />
      </div>
    </div>
  </div>
  ) : (
    <main class="container"><h1>{t(locale, 'product.notFoundTitle')}</h1></main>
  )}

  {productJsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
  )}
</Layout>

<script>
  import { subscribeToStockUpdates } from '../../api/catalog'
  import { t } from '../../i18n'

  const stockElement = document.querySelector('#product-stock')
  const productId = stockElement?.getAttribute('data-product-id')

  if (stockElement && productId) {
    subscribeToStockUpdates(
      productId,
      ({ stock }) => {
        stockElement.textContent = stock > 0 ? t('es', 'product.pieces', { count: stock }) : t('es', 'product.soldOut')
        stockElement.dataset.stock = String(stock)
        window.dispatchEvent(new CustomEvent('product-stock-updated', {
          detail: { productId, stock },
        }))
      },
      (error) => console.error('No se pudo actualizar el inventario del producto.', error),
    )
  }
</script>