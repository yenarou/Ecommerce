---
import Layout from '../../layouts/Layout.astro'
import AddToCartForm from '../../components/AddToCartForm.jsx'
import { fetchProductById } from '../../api/catalog'
import { useTranslations, rutaLocal } from '../../i18n/ui.js'
import '../../styles/ProductDetail.css'

const locale = Astro.currentLocale ?? 'es'
const t = useTranslations(locale)

const { id } = Astro.params
const product = id ? await fetchProductById(id) : null
if (!product) Astro.response.status = 404
const category = product?.category

const jsonLd = product && {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  image: product.images.map((i: any) => i.url),
  description: product.description,
  offers: {
    '@type': 'Offer',
    price: product.price,
    priceCurrency: product.currency,
    availability: product.stock > 0 ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
    url: Astro.url.href,
  },
}
---
<Layout
  title={product ? `${product.name} | Hilo y Alma` : t('prod.noEncontrado')}
  description={product ? (product.description ?? '').slice(0, 155) : undefined}
  image={product?.images[0]?.url}
  jsonLd={jsonLd}
>
  {product ? (
  <main class="container product-detail">
    <nav class="product-detail__crumbs" aria-label={t('common.ruta')}>
      <a href={rutaLocal(locale, '/')}>{t('common.inicio')}</a> <span aria-hidden="true">/</span>{' '}
      {category && <a href={rutaLocal(locale, `/categoria/${category.slug}`)}>{category.name}</a>}{' '}
      <span aria-hidden="true">/</span> {product.name}
    </nav>

    <div class="product-detail__layout">
      <div class="product-detail__gallery">
        <div class="product-detail__main-image">
          <img
            src={product.images[0]?.url}
            alt={product.images[0]?.alt || product.name}
            width="800"
            height="800"
            decoding="async"
            fetchpriority="high"
          />
        </div>
        {product.images.length > 1 && (
          <div class="product-detail__thumbs">
            {product.images.slice(1).map((img: any) => (
              <div class="product-detail__thumb">
                <img src={img.url} alt={img.alt || product.name} width="200" height="200" loading="lazy" decoding="async" />
              </div>
            ))}
          </div>
        )}
      </div>

      <div class="product-detail__info">
        <h1 class="product-detail__name">{product.name}</h1>
        <p class="price product-detail__price">${product.price.toFixed(2)} {product.currency}</p>
        <p class="product-detail__description">{product.description}</p>

        <dl class="product-detail__facts">
          <div>
            <dt>{t('prod.disponibilidad')}</dt>
            <dd
              id="product-stock"
              data-product-id={product.id}
              data-stock={product.stock}
              data-pieces={t('prod.piezas')}
              data-soldout={t('prod.agotado')}
              aria-live="polite"
            >{product.stock > 0 ? `${product.stock} ${t('prod.piezas')}` : t('prod.agotado')}</dd>
          </div>
        </dl>

        <hr class="stitch-divider" />

        <AddToCartForm client:idle product={product} locale={locale} />
      </div>
    </div>
  </main>
  ) : (
    <main class="container"><h1>{t('prod.noEncontrado')}</h1></main>
  )}
</Layout>

<script>
  import { subscribeToStockUpdates } from '../../api/catalog'

  const stockElement = document.querySelector<HTMLElement>('#product-stock')
  const productId = stockElement?.getAttribute('data-product-id')

  if (stockElement && productId) {
    const piezas = stockElement.dataset.pieces ?? 'piezas'
    const agotado = stockElement.dataset.soldout ?? 'Agotado'

    subscribeToStockUpdates(
      productId,
      ({ stock }: { stock: number }) => {
        stockElement.textContent = stock > 0 ? `${stock} ${piezas}` : agotado
        stockElement.dataset.stock = String(stock)
        window.dispatchEvent(new CustomEvent('product-stock-updated', {
          detail: { productId, stock },
        }))
      },
      (error: unknown) => console.error('No se pudo actualizar el inventario del producto.', error),
    )
  }
</script>