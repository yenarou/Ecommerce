---
import Layout from '../../layouts/Layout.astro'
import AddToCartForm from '../../components/AddToCartForm.jsx'
import { fetchProductById } from '../../api/catalog'
import '../../styles/ProductDetail.css'

const { id } = Astro.params
const product = id ? await fetchProductById(id) : null
if (!product) Astro.response.status = 404
const category = product?.category
---
<Layout title={product ? `${product.name} | Hilo y Alma` : 'Producto no encontrado'}>
  {product ? (
  <div class="container product-detail">
    <nav class="product-detail__crumbs" aria-label="Ruta de navegación">
      <a href="/">Inicio</a> <span aria-hidden="true">/</span>{' '}
      {category && <a href={`/categoria/${category.slug}`}>{category.name}</a>}{' '}
      <span aria-hidden="true">/</span> {product.name}
    </nav>

    <div class="product-detail__layout">
      <div class="product-detail__gallery">
        <div class="product-detail__main-image">
          <img src={product.images[0]?.url} alt={product.images[0]?.alt || product.name} />
        </div>
        {product.images.length > 1 && (
          <div class="product-detail__thumbs">
            {product.images.slice(1).map(img => (
              <div class="product-detail__thumb">
                <img src={img.url} alt={img.alt} />
              </div>
            ))}
          </div>
        )}
      </div>

      <div class="product-detail__info">
        <h1 class="product-detail__name">{product.name}</h1>
        <p class="price product-detail__price">${product.price.toFixed(2)} {product.currency}</p>
        <p class="product-detail__description">{product.description}</p>

        <dl class="product-detail__facts">
          <div>
            <dt>Disponibilidad</dt>
            <dd>{product.stock > 0 ? `${product.stock} piezas` : 'Agotado'}</dd>
          </div>
        </dl>

        <hr class="stitch-divider" />

        <AddToCartForm client:load product={product} />
      </div>
    </div>
  </div>
  ) : (
    <main class="container"><h1>Producto no encontrado</h1></main>
  )}
</Layout>