---
import Layout from '../../layouts/Layout.astro'
import AddToCartForm from '../../components/AddToCartForm.jsx'
import { fetchProductById } from '../../api/catalog'
import '../../styles/ProductDetail.css'

const { id } = Astro.params
const product = id ? await fetchProductById(id) : null
if (!product) {
  Astro.response.status = 404
} else {
  Astro.response.headers.set('Cache-Control', 'public, max-age=60, stale-while-revalidate=300')
}
const category = product?.category
const images: { url: string; alt?: string }[] = product?.images ?? []
const mainImage = images[0]
---
<Layout title={product ? `${product.name} | Hilo y Alma` : 'Producto no encontrado'}>
  {product ? (
  <div class="container product-detail">
    <nav class="product-detail__crumbs" aria-label="Ruta de navegación">
      <a href="/">Inicio</a> <span aria-hidden="true">/</span>{' '}
      {category && <a href={`/categoria/${category.slug}`}>{category.name}</a>}{' '}
      <span aria-hidden="true">/</span> {product.name}
    </nav>

    <div class="product-detail__layout">
      <div class="product-detail__gallery">
        <div class="product-detail__main-image">
          {mainImage ? (
            <img src={mainImage.url} alt={mainImage.alt || product.name} width="800" height="800" loading="eager" fetchpriority="high" decoding="async" />
          ) : (
            <div class="product-detail__no-image">Sin imagen</div>
          )}
        </div>
        {images.length > 1 && (
          <div class="product-detail__thumbs">
            {images.slice(1).map(img => (
              <div class="product-detail__thumb">
                <img src={img.url} alt={img.alt} width="120" height="120" loading="lazy" decoding="async" />
              </div>
            ))}
          </div>
        )}
      </div>

      <div class="product-detail__info">
        <h1 class="product-detail__name">{product.name}</h1>
        <p class="price product-detail__price">${product.price.toFixed(2)} {product.currency}</p>
        <p class="product-detail__description">{product.description}</p>

        <dl class="product-detail__facts">
          <div>
            <dt>Disponibilidad</dt>
            <dd
              id="product-stock"
              data-product-id={product.id}
              data-stock={product.stock}
              aria-live="polite"
            >{product.stock > 0 ? `${product.stock} piezas` : 'Agotado'}</dd>
          </div>
        </dl>

        <hr class="stitch-divider" />

        <AddToCartForm client:idle product={product} />
      </div>
    </div>
  </div>
  ) : (
    <main class="container"><h1>Producto no encontrado</h1></main>
  )}
</Layout>

<script>
  const stockElement = document.querySelector('#product-stock')
  const productId = stockElement?.getAttribute('data-product-id')

  async function startStockUpdates() {
    if (!stockElement || !productId) return

    const { subscribeToStockUpdates } = await import('../../api/catalog')

    subscribeToStockUpdates(
      productId,
      ({ stock }) => {
        stockElement.textContent = stock > 0 ? `${stock} piezas` : 'Agotado'
        stockElement.dataset.stock = String(stock)
        window.dispatchEvent(new CustomEvent('product-stock-updated', {
          detail: { productId, stock },
        }))
      },
      (error) => console.error('No se pudo actualizar el inventario del producto.', error),
    )
  }

  if ('requestIdleCallback' in window) {
    requestIdleCallback(startStockUpdates, { timeout: 3000 })
  } else {
    setTimeout(startStockUpdates, 1500)
  }
</script>