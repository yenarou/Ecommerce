---
import Layout from '../../layouts/Layout.astro'
import Sidebar from '../../components/Sidebar.astro'
import ProductCard from '../../components/ProductCard.astro'
import { fetchCategoryBySlug } from '../../api/catalog'
import { useTranslations, rutaLocal } from '../../i18n/ui.js'
import '../../styles/CategoryDetail.css'

const locale = Astro.currentLocale ?? 'es'
const t = useTranslations(locale)

const { slug } = Astro.params
const category = slug ? await fetchCategoryBySlug(slug) : null
if (!category) Astro.response.status = 404
const products: any[] = category?.products ?? []
---
<Layout
  title={category ? `${category.name} | Hilo y Alma` : t('cat.noEncontrada')}
  description={category ? `${category.description} ${t('cat.meta').replace('{n}', category.name.toLowerCase())}` : undefined}
>
  {category ? (
  <div class="container category-detail">
    <nav class="category-detail__crumbs" aria-label={t('common.ruta')}>
      <a href={rutaLocal(locale, '/')}>{t('common.inicio')}</a> <span aria-hidden="true">/</span> {category.name}
    </nav>

    <div class="category-detail__layout">
      <Sidebar />
      <main class="category-detail__main">
        <h1 class="category-detail__title">{category.name}</h1>
        <p class="category-detail__description">{category.description}</p>

        <hr class="stitch-divider" />

        {products.length === 0 ? (
          <p class="category-detail__empty">{t('cat.vacia')}</p>
        ) : (
          <div class="category-detail__grid">
            {products.map((product, i) => <ProductCard product={product} level={2} priority={i < 2} />)}
          </div>
        )}
      </main>
    </div>
  </div>
  ) : (
    <main class="container"><h1>{t('cat.noEncontrada')}</h1></main>
  )}
</Layout>