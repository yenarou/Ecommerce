---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/Hero.astro'
import Sidebar from '../components/Sidebar.astro'
import ProductCard from '../components/ProductCard.astro'
import { fetchProducts } from '../api/catalog'
import { useTranslations } from '../i18n/ui.js'
import '../styles/Home.css'

const t = useTranslations(Astro.currentLocale ?? 'es')
const { items: featured }: { items: any[] } = await fetchProducts({ page: 1, pageSize: 4 })
---
<Layout title={t('home.titulo')} description={t('home.descripcion')}>
  <div class="container home">
    <Hero />

    <div class="home__layout">
      <Sidebar />

      <main class="home__main">
        <h2 class="home__section-title">{t('home.destacadas')}</h2>
        <div class="home__grid">
          {featured.map((product) => <ProductCard product={product} />)}
        </div>
      </main>
    </div>

    <hr class="stitch-divider" />

    <section class="home__context">
      <div>
        <h2>{t('home.encargo.titulo')}</h2>
        <p>{t('home.encargo.texto')}</p>
      </div>
      <div>
        <h2>{t('home.personaliza.titulo')}</h2>
        <p>{t('home.personaliza.texto')}</p>
      </div>
    </section>
  </div>
</Layout>